# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key - server-side only, never exposed to the client.
# Used by the LLM parser (order paste / price paste parsing).
ANTHROPIC_API_KEY=

# Authenticates Vercel Cron's request to /api/cron/engagement-recompute.
# Vercel sets this automatically as a project env var for cron-triggered
# requests; set it locally too if you want to hit the route by hand.
CRON_SECRET=
