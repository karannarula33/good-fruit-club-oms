# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key - server-side only, never exposed to the client.
# Used by the LLM parser (order paste / price paste parsing).
ANTHROPIC_API_KEY=

# Authenticates Vercel Cron's request to /api/cron/engagement-recompute
# and /api/cron/sheet-sync. Vercel sets this automatically as a project
# env var for cron-triggered requests; set it locally too if you want to
# hit either route by hand.
CRON_SECRET=

# Google service account (Sheets API) - for the daily order -> Google
# Sheets sync (/api/cron/sheet-sync). Create a GCP service account with
# the Sheets API enabled, download its JSON key, and share the target
# Google Sheet with the service account's client_email as Editor.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_ORDERS_TAB=Orders

# Google Maps Distance Matrix API - real driving distance from the Gurgaon
# delivery hub to each customer, for the per-order delivery-partner charge.
# Needs a billing-enabled GCP project with the Distance Matrix API enabled
# (it's a paid API).
GOOGLE_MAPS_API_KEY=
